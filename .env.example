APP_NAME=سكينة
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://sakina.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

CUSTOMER_DEFAULT_PASSWORD=password
CUSTOMER_OTP_STATIC=1234

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sakina
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sakina.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PRAYER_CALCULATION_METHOD=egyptian
PRAYER_ASR_METHOD=standard
PRAYER_HIGH_LATITUDE_RULE=middle_of_night

# Nearby mosques: overpass (OpenStreetMap, free) or google (Places API New)
PLACES_PROVIDER=overpass
PLACES_API_KEY=
PLACES_TIMEOUT=10
PLACES_CACHE_TTL=86400
PLACES_OVERPASS_TIMEOUT=15
PLACES_OVERPASS_BUDGET=25

# local = built-in calculator (no network), aladhan = https://api.aladhan.com/v1
PRAYER_TIMES_PROVIDER=local
PRAYER_TIMES_API_URL=https://api.aladhan.com/v1
PRAYER_TIMES_API_KEY=

# Translations/tafsir only; the Arabic text is the local Tanzil source.
QURAN_PROVIDER=alquran_cloud
QURAN_API_URL=https://api.alquran.cloud/v1
QURAN_API_KEY=
QURAN_TRANSLATION_EN=en.sahih
QURAN_TRANSLATION_CKB=ku.asan
QURAN_TAFSIR_AR=ar.muyassar
